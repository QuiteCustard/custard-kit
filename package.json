{
  "name": "custard-kit",
  "version": "0.1.0",
  "description": "Reusable TypeScript helpers published as @quitecustard/core, @quitecustard/payload and @quitecustard/services",
  "private": true,
  "license": "MIT",
  "author": "QuiteCustard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuiteCustard/custard-kit.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "release": "pnpm verify && pnpm -r publish"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.11"
  }
}
